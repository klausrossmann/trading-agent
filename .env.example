# Copy to .env on the runtime host (chmod 600). Never commit real values.
# Database passwords are not set here: they live in secrets/ (run `make secrets`).
# Comments only on their own lines: Docker Compose reads "KEY=   # text" as the value "# text".

# --- Core (M0) ---
# paper | live (live also needs the interlock, IMPLEMENTATION.md 10.4)
APP_MODE=paper
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Ping URL of the heartbeat check, e.g. https://hc-ping.com/<uuid> (healthchecks.io); empty = no ping
HEARTBEAT_URL=
# Read by scripts/backup.sh: a second check that pings after each nightly backup
BACKUP_HEARTBEAT_URL=
# age public key (age1...) for the weekly offsite copy; the private key stays off this host
BACKUP_AGE_RECIPIENT=
TZ=Europe/Berlin

# --- Database (defaults match compose.yaml; password comes from secrets/agent_db_password) ---
DB_HOST=db
DB_PORT=5432
DB_NAME=trading
DB_USER=agent

# --- Data (M1) ---
FRED_API_KEY=
# Since M9: company news for held positions (free key at finnhub.io)
FINNHUB_API_KEY=
# "Name email", required by the SEC
SEC_EDGAR_USER_AGENT=

# --- Telegram (M4) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# --- LLM (M5 / M7) ---
# Google AI Studio key (free tier is fine in Phase 0-1)
GEMINI_API_KEY=
# true: config/models.yaml dev_overrides (critic on Gemini until an Anthropic key exists)
LLM_DEV_OVERRIDES=true
# true only in compose.dev.yaml: offline fake answers, no API calls
LLM_FAKE=false
# Added in M7 (critic)
ANTHROPIC_API_KEY=

# --- IBKR gateway (M6) ---
# ibkr: also start the ib-gateway container
COMPOSE_PROFILES=
# true: the agent connects (read-only) and reconciles
IB_ENABLED=false
# true (M8 step 5): orders go to IBKR, not the simulator
IB_ORDERS_ENABLED=false
# Gateway setting; "no" together with IB_ORDERS_ENABLED=true
IB_READ_ONLY_API=yes
# IBKR username; the gateway logs in in paper mode. Password: make tws-password
TWS_USERID=
IB_HOST=ib-gateway
# 4004 paper, 4003 live (gnzsnz socat ports)
IB_PORT=4004
IB_CLIENT_ID=11
