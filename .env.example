# Copy to .env on the runtime host (chmod 600). Never commit real values.
# Database passwords are not set here: they live in secrets/ (run `make secrets`).

# --- Core (M0) ---
APP_MODE=paper                      # paper | live (live also needs the interlock, IMPLEMENTATION.md 10.4)
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
HEARTBEAT_URL=                      # ping URL from the heartbeat service, e.g. healthchecks.io; empty = no ping
BACKUP_HEARTBEAT_URL=               # read by scripts/backup.sh: a second check that pings after each nightly backup
BACKUP_AGE_RECIPIENT=               # age public key (age1...) for the weekly offsite copy; the private key stays off this host
TZ=Europe/Berlin

# --- Database (defaults match compose.yaml; password comes from secrets/agent_db_password) ---
DB_HOST=db
DB_PORT=5432
DB_NAME=trading
DB_USER=agent

# --- Data (M1) ---
FRED_API_KEY=
FINNHUB_API_KEY=                    # since M9: company news for held positions (free key at finnhub.io)
SEC_EDGAR_USER_AGENT=               # "Name email", required by the SEC

# --- Telegram (M4) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# --- LLM (M5 / M7) ---
GEMINI_API_KEY=                     # Google AI Studio key (free tier is fine in Phase 0-1)
LLM_DEV_OVERRIDES=true              # true: config/models.yaml dev_overrides (critic on Gemini until M7)
LLM_FAKE=false                      # true only in compose.dev.yaml: offline fake answers, no API calls
ANTHROPIC_API_KEY=                  # added in M7 (critic)

# --- IBKR gateway (M6) ---
# Both switches stay off until the paper login exists (IMPLEMENTATION.md 15.5 step 13).
COMPOSE_PROFILES=                   # ibkr: also start the ib-gateway container
IB_ENABLED=false                    # true: the agent connects (read-only) and reconciles
IB_ORDERS_ENABLED=false             # true (M8 step 5): orders go to IBKR, not the simulator
IB_READ_ONLY_API=yes                # gateway setting; "no" together with IB_ORDERS_ENABLED=true
TWS_USERID=                         # paper login has its own username; password: make tws-password
IB_HOST=ib-gateway
IB_PORT=4004                        # 4004 paper, 4003 live (gnzsnz socat ports)
IB_CLIENT_ID=11
